# Copy to .env and fill in. The app refuses to start if NVR_PASSWORD or
# NVR_SECRET_KEY is empty or still an example value.

# Single shared UI password. Minimum 8 characters.
NVR_PASSWORD=

# Encrypts camera passwords at rest and signs session cookies.
# Minimum 32 characters. Generate one with:
#   openssl rand -hex 32
NVR_SECRET_KEY=

# Port the UI and API listen on. Honoured by the entrypoint.
NVR_PORT=8080

# Local time zone, used for display only. All timestamps are stored UTC.
# Set yours, e.g. Europe/London or America/New_York.
TZ=UTC

# Ownership applied to /config and /recordings before privileges are dropped.
PUID=1000
PGID=1000
